# Capability manifest — which nmem / nmem-sym capabilities this agent runs with.
# nmem (NMEM_*) and nmem-sym (NMEM_SYM_*) are pydantic BaseSettings: they read these
# from the environment at import. Load before starting the agent:
#     set -a; . ./capabilities.env; set +a
#
# IMPORTANT: NO inline `#` comments on an ENABLED line — env parsing keeps everything
# after `=` as the value, so `FLAG=true # note` fails to parse as a boolean. Put notes
# on their own line above the flag.

# ── nmem-sym: drives / goals / pursuit substrate ──
NMEM_SYM_DRIVES_ENABLED=true
# Event-wake + honest discharge: drives fire on real pressure, not a fixed tick
# (no cold-start spin on a sparse graph).
NMEM_SYM_DRIVES_WAKE_MODE=event
NMEM_SYM_DRIVES_HONEST_DISCHARGE=true
NMEM_SYM_DRIVES_CREATE_GOALS=true
NMEM_SYM_DRIVES_GOAL_LLM_ENRICH=true
NMEM_SYM_CONCERNS_ENABLED=true

# ── nmem-sym: memory graph richness ──
NMEM_SYM_SCHEMAS_ENABLED=true
NMEM_SYM_ANALOGY_ENABLED=true
NMEM_SYM_SELF_MODEL_ENABLED=true
NMEM_SYM_PROCEDURES_ENABLED=true
NMEM_SYM_GOALS_ENABLED=true
NMEM_SYM_PREDICTION_ENABLED=true

# ── nmem: experiential learning + recall ──
NMEM_SKILLS__ENABLED=true
NMEM_AUTONOMY__ENABLED=true
NMEM_AUTONOMY__PROACTIVE_RETRIEVE=true
NMEM_SYM_RECALL_DRIVE_ENABLED=1
NMEM_SYM_RECALL_AGENT_ID=scout

# ── nmem: self-improvement (advisory context recipes; never touches code) ──
NMEM_SELF_ENGINEERING__ENABLED=true
NMEM_SELF_ENGINEERING__INCLUDE_IN_PROMPT=true
