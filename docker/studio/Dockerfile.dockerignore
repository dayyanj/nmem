# Build-context filter for the nmem-studio image (BuildKit reads <dockerfile>.dockerignore).
# Context is the apps/ monorepo root; ship the studio libs + nmem-viz + nmem-sym-sensor sources.
*
!nmem
!nmem-sym
!nmem-act
!nmem-exchange
!nmem-sym-sensor
!nmem-viz

# prune heavy / irrelevant bits from the included libraries (last-match-wins)
**/.git
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/node_modules
**/.pytest_cache
**/.mypy_cache
nmem/docs
nmem/tests
nmem-sym/tests
nmem-act/tests
nmem-exchange/tests
nmem-sym-sensor/tests
# nmem-sym-sensor's working tree carries multi-GB local artifacts (training videos, audio, model
# checkpoints) pip does NOT need — excluding them keeps the image lean (else the COPY balloons it ~20GB).
nmem-sym-sensor/videos
nmem-sym-sensor/training_data
nmem-sym-sensor/checkpoints*
nmem-sym-sensor/_design
nmem-sym-sensor/**/*.pth
nmem-sym-sensor/**/*.onnx
nmem-sym-sensor/**/*.mp4
nmem-sym-sensor/**/*.wav
nmem-viz/node_modules
nmem-viz/dist
