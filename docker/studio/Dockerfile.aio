# nmem-studio ALL-IN-ONE — the one-line trial image.
#
#   docker run -p 8080:8080 -p 5174:5174 -v nmem:/data <registry>/nmem-studio-aio
#   → open http://localhost:8080  (wizard);  http://localhost:5174  (brain viz)
#
# Everything a solo agent needs in ONE container: Postgres+pgvector, the studio, and nmem-viz — run
# by supervisord so the studio's create→restart seam works IN-container (no `docker run --restart`
# needed). ALL state (agent config + the database) lives on the single /data volume, so it survives
# `docker rm` and comes back in agent mode. The LLM stays external (point the wizard at your endpoint).
#
# For production / multi-agent / the identity+perception profiles, use docker-compose.yml instead.
# Build context is the apps/ monorepo root (reaches the sibling nmem-* + nmem-viz sources).

# ── stage 1: build the nmem-viz SPA ──────────────────────────────────────────────
FROM node:20-slim AS viz-spa
WORKDIR /build
COPY nmem-viz/package.json nmem-viz/package-lock.json ./
RUN npm ci
COPY nmem-viz/ .
RUN npm run build

# ── stage 2: the all-in-one runtime (Postgres+pgvector base) ─────────────────────
FROM pgvector/pgvector:pg16

ARG VERSION=dev
LABEL org.opencontainers.image.title="nmem-studio" \
      org.opencontainers.image.description="All-in-one (Postgres+studio+viz) pull-and-run appliance for an autonomous nmem agent" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://spwig.com" \
      org.opencontainers.image.licenses="BUSL-1.1 AND MIT"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STUDIO_DATA_DIR=/data \
    STUDIO_PORT=8080 \
    STUDIO_BIND_HOST=0.0.0.0 \
    NMEM_STUDIO_VERSION=${VERSION} \
    HF_HOME=/opt/hf \
    PGDATA=/data/pgdata \
    VENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    POSTGRES_HOST=127.0.0.1 \
    POSTGRES_PORT=5432 \
    POSTGRES_USER=nmem \
    POSTGRES_PASSWORD=nmem \
    NMEM_AGENT_DB=agent_nmem \
    NMEM_PERSONA_RECONCILE_OBJECTIVES=1 \
    NMEM_SYM_VIZ_ENABLED=1 \
    NMEM_VIZ_INGEST_URL=http://127.0.0.1:5174/ingest \
    NMEM_VIZ_PUBLIC_URL=http://localhost:5174/

# python + build tools + supervisor + gosu (to run postgres as the postgres user); the pgvector base
# already carries the postgres-16 server + the vector extension.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev build-essential curl supervisor gosu \
 && rm -rf /var/lib/apt/lists/*

# App deps in a venv (keeps them off the system python PEP-668 gripes). CPU torch FIRST so
# sentence-transformers doesn't drag the multi-GB CUDA build.
COPY nmem /src/nmem
COPY nmem-sym /src/nmem-sym
COPY nmem-act /src/nmem-act
COPY nmem-exchange /src/nmem-exchange
RUN python3 -m venv "$VENV" \
 && pip install --upgrade pip \
 && pip install torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install "/src/nmem[openai,anthropic,computer-use]" /src/nmem-sym /src/nmem-act /src/nmem-exchange \
 && pip install "uvicorn[standard]" fastapi asyncpg pyyaml mcp \
 && pip install aiohttp websockets numpy pydantic-settings    # nmem-viz server deps

# Preload the bundled embedder so first agent boot is fast + offline.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# nmem-viz: the built SPA + its aiohttp server (run from /opt/viz).
COPY --from=viz-spa /build/dist /opt/viz/dist
COPY nmem-viz/server /opt/viz/server

# studio entrypoint (reused: sources capabilities.env in agent mode, then runs the server) + the
# AIO orchestration (pg init on the volume + supervisord).
COPY nmem/docker/studio/entrypoint.sh /entrypoint.sh
COPY nmem/docker/studio/aio-studio.sh /aio-studio.sh
COPY nmem/docker/studio/aio-entrypoint.sh /aio-entrypoint.sh
COPY nmem/docker/studio/supervisord.aio.conf /etc/supervisor/conf.d/nmem.conf
RUN chmod +x /entrypoint.sh /aio-studio.sh /aio-entrypoint.sh

VOLUME ["/data"]
EXPOSE 8080 5174
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8080/health >/dev/null 2>&1 || curl -fsS http://127.0.0.1:8080/studio/catalog >/dev/null 2>&1 || exit 1
ENTRYPOINT ["/aio-entrypoint.sh"]
