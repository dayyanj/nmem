# Build-context filter for the all-in-one image (BuildKit reads <dockerfile>.dockerignore).
# Context is the apps/ monorepo root; ship the studio libs + nmem-viz source.
*
!nmem
!nmem-sym
!nmem-act
!nmem-exchange
!nmem-viz

# prune heavy / irrelevant bits (last-match-wins)
**/.git
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
nmem/docs
nmem/tests
nmem-sym/tests
nmem-act/tests
nmem-exchange/tests
nmem-viz/node_modules
nmem-viz/dist
